# IDE
.vscode/

# Environment
.env
.env.*

# Runtime / secrets (generated on server)
storage/*
!storage/.htaccess
uploads/ids/*
!uploads/ids/.htaccess
uploads/staff/*
!uploads/staff/.htaccess

# Logs & temp
*.log
*.tmp
*.temp

# Composer (use global composer; vendor/ is committed for deploy)
composer.phar
composer-setup.php

# Runtime rate-limit cache
storage/rate_limits/*.json
!storage/rate_limits/.gitkeep

# OS
.DS_Store
Thumbs.db
